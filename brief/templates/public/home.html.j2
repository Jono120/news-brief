{% extends "base.html.j2" %}

{% block title %}{{ site.title }} — {{ site.tagline }}{% endblock %}

{% block content %}
<section class="panel stack" aria-labelledby="featured-issue-heading">
  <div class="stack">
    {% if featured.is_sample %}
    <p><span class="badge badge-sample">Sample issue</span></p>
    {% else %}
    <p><span class="badge badge-live">Latest issue</span></p>
    {% endif %}

    <h1 id="featured-issue-heading" class="h1">
      {% if featured.is_sample %}Preview the briefing{% else %}Issue for {{ featured.date }}{% endif %}
    </h1>

    <p>{{ featured.intro }}</p>

    <ul class="meta-list" aria-label="Issue details">
      <li>{{ featured.story_count }} stories</li>
      <li>APAC relevance {{ '%.0f'|format(featured.apac_ratio * 100) }}%</li>
    </ul>

    <div class="actions">
      <a class="button button-primary" href="/issues/{{ featured.date }}">
        Read full issue
      </a>
    </div>
  </div>
</section>

<div class="grid grid-sidebar">
  <section class="panel" aria-labelledby="top-stories-heading">
    <h2 id="top-stories-heading" class="h2">Top stories</h2>
    <ol class="story-list">
      {% for story in featured.stories[:4] %}
      <li class="story-preview">
        <article aria-labelledby="story-{{ loop.index }}-title">
          <ul class="meta-list" aria-label="Story details">
            <li>{{ categories.get(story.category, story.category) }}</li>
            <li>{{ story.read_time_minutes }} min read</li>
          </ul>
          <h3 id="story-{{ loop.index }}-title" class="h3">{{ story.title }}</h3>
          <p>{{ story.summary }}</p>
        </article>
      </li>
      {% endfor %}
    </ol>
  </section>

  <aside class="stack" aria-label="Sidebar">
    <section class="panel" aria-labelledby="recent-issues-heading">
      <h2 id="recent-issues-heading" class="h2">Recent issues</h2>
      <ul class="issue-list">
        {% for item in recent %}
        <li>
          <a href="/issues/{{ item.date }}">
            <span>{% if item.is_sample %}Sample preview{% else %}{{ item.date }}{% endif %}</span>
            <span class="meta">{{ item.story_count }} stories</span>
          </a>
        </li>
        {% endfor %}
      </ul>
      <div class="actions">
        <a class="button button-secondary" href="/issues">View archive</a>
      </div>
    </section>

    <section class="panel subscribe-box" aria-labelledby="subscribe-heading">
      <h2 id="subscribe-heading" class="h2">Get the weekday email</h2>
      <p class="meta">Free APAC tech briefing in your inbox. Launching soon.</p>
      <form class="subscribe-form" action="#" method="post" aria-describedby="subscribe-note">
        <label for="subscribe-email">Email address</label>
        <input
          id="subscribe-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@company.com"
          disabled
          aria-disabled="true"
        />
        <button type="submit" class="button button-secondary is-disabled" disabled aria-disabled="true">
          Subscribe — coming soon
        </button>
        <p id="subscribe-note" class="meta">Email signup is not active in this preview yet.</p>
      </form>
    </section>
  </aside>
</div>
{% endblock %}
