{% extends "base.html.j2" %}

{% block title %}Page not found — {{ site.title }}{% endblock %}
{% block description %}The requested Brief APAC page could not be found.{% endblock %}

{% block content %}
<section class="panel stack" aria-labelledby="not-found-heading">
  <h1 id="not-found-heading" class="h1">Page not found</h1>
  <p>We could not find the page you requested.</p>
  <div class="actions">
    <a class="button button-primary" href="/">Go to latest issue</a>
    <a class="button button-secondary" href="/issues">Browse archive</a>
  </div>
</section>
{% endblock %}
