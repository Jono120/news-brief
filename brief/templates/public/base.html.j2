<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>{% block title %}{{ site.title }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ site.description }}{% endblock %}" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS" href="/feed.xml" />
  <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.bunny.net/css?family=atkinson-hyperlegible:400,400i,700,700i&amp;display=swap"
  />
  <link rel="stylesheet" href="/static/css/site.css" />
  {% block head_extra %}{% endblock %}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <div class="page">
    <header class="site-header" role="banner">
      <div class="site-brand">
        <p class="site-kicker">{{ site.tagline }}</p>
        <a class="site-logo" href="/">{{ site.title }}</a>
      </div>

      <div class="header-tools">
        <button
          type="button"
          class="nav-toggle"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="site-nav"
        >
          Menu
        </button>
        <nav aria-label="Primary">
          <ul id="site-nav" class="site-nav">
            <li><a href="/"{% if current_path == "/" %} aria-current="page"{% endif %}>Latest</a></li>
            <li><a href="/issues"{% if current_path == "/issues" %} aria-current="page"{% endif %}>Archive</a></li>
            <li><a href="/feed.xml">RSS feed</a></li>
            <li><a href="/accessibility"{% if current_path == "/accessibility" %} aria-current="page"{% endif %}>Accessibility</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      {% block content %}{% endblock %}
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="footer-grid">
        <div>
          <p><strong>{{ site.title }}</strong> — curated technology stories for builders and operators across Asia-Pacific.</p>
          <p class="meta">Weekday briefings · about five minutes · independent editorial · en-NZ</p>
        </div>
        <div>
          <p class="meta">Site</p>
          <ul class="footer-links">
            <li><a href="/issues">Issue archive</a></li>
            <li><a href="/feed.xml">RSS feed</a></li>
            <li><a href="/accessibility">Accessibility</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </div>

  <script src="/static/js/site.js" defer></script>
</body>
</html>
