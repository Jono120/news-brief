# Optional — enables higher-quality summaries via OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Database backend: sqlite (default) or supabase (development)
# BRIEF_DATABASE=sqlite

# Supabase — set BRIEF_DATABASE=supabase and apply supabase/migrations/
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API auth — set to require `Authorization: Bearer <token>` on the review API.
# Required for any non-localhost deployment; give the same value to the UI.
# BRIEF_API_TOKEN=change-me
# VITE_API_TOKEN=change-me

# TypeScript UI — API proxy for review app (Vite); must match `brief review` TLS mode
# VITE_API_PROXY=http://127.0.0.1:8787
# VITE_API_PROXY=https://127.0.0.1:8787

# Extra CORS origins (comma-separated)
# BRIEF_CORS_ORIGINS=http://localhost:3000
